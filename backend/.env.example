# =====================================================================
# MULTI-AGENT RAG PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual credentials.
# =====================================================================

# 1. APPLICATION & AUTHENTICATION
PROJECT_NAME="Multi-Agent RAG Platform"
SECRET_KEY="production-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# 2. LLM PROVIDER CONFIGURATION
# Options: gemini | ollama | mistral | deepseek | kimi
LLM_PROVIDER=gemini

# Gemini AI API Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# Ollama Local LLM (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Mistral AI (Optional)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# DeepSeek AI (Optional)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Kimi / Moonshot AI (Optional)
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k

# 3. EMBEDDINGS MODEL
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384

# 4. DATABASE & VECTOR STORE
# For local SQLite fallback, leave DATABASE_URL empty.
# For Production Postgres + pgvector (Supabase / Neon.tech / AWS RDS):
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.xxxx.supabase.co:5432/postgres

# Alternatively, set individual Postgres params:
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db

# 5. REDIS CACHE & RATE LIMITING (Upstash / Local Redis)
# Set ENABLE_REDIS_CACHE=True to activate query caching
ENABLE_REDIS_CACHE=True
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=60

# 6. CLOUD DOCUMENT STORAGE (Supabase Storage / Local Disk)
# For local disk storage, leave SUPABASE_URL empty.
# For Cloud Storage (Supabase Storage):
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
STORAGE_BUCKET=rag-documents

# Local Upload Directory Fallback
MAX_FILE_SIZE_MB=25
