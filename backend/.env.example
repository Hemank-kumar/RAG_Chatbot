# Server Configuration
PROJECT_NAME="Multi-Agent RAG Platform"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-secure-random-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db

# Gemini LLM Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face Embeddings Settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# RAG & Retrieval Config
HYBRID_ALPHA=0.5
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
MAX_VERIFICATION_RETRIES=2
